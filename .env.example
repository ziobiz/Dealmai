# DealMai API / VPS environment template
# Copy to /etc/dealmai/env on the server (chmod 600). Never commit real values.

PORT=3000
PUBLIC_SITE_URL=https://dealmai.com

# Firebase Admin (required for most /.netlify/functions/*)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google SMTP (preferred on VPS). Use an App Password for Gmail/Google Workspace.
# Mail transport (prefer Admin → Email SMTP in Firestore; env is fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DealMai <noreply@your-domain.com>"
EMAIL_REPLY_TO=support@dealmai.com
# EMAIL_SUPPORT_BCC=support@dealmai.com

# Optional legacy Resend fallback (used only when SMTP_* is not set)
# RESEND_API_KEY=

# ChillPay (legacy direct gateway — keep for rollback)
CHILLPAY_MERCHANT_CODE=
CHILLPAY_API_KEY=
CHILLPAY_MD5_SECRET=
CHILLPAY_MODE=sandbox
# CHILLPAY_ROUTE_NO=1

# ICOPay unified checkout (DealMai → ICOPay → EPS via HQ merchantPgBindings)
# Register webhook: https://dealmai.com/.netlify/functions/payment-callback/icopay
# HQ: BACKGROUND / RESULT / MIDDLEWARE (+ sandbox URLs) on the DealMai merchant
ICOPAY_API_BASE=https://api.icopay.co.kr
ICOPAY_COMP_ID=
ICOPAY_BROKER_SECRET=
# ICOPAY_BROKER_SECRET_SANDBOX=
ICOPAY_MODE=sandbox
ICOPAY_CURRENCY=THB
# Optional HMAC for X-Icopay-Signature (v1=hex) when HQ sets notify sign_secret
# ICOPAY_NOTIFY_SIGN_SECRET=

# Partner webhook / FX / DM Champ (as needed)
# ONTHELINE_WEBHOOK_SECRET=
# ONTHELINE_ALLOWED_IPS=
# DMCHAMP_API_KEY=
# FREECURRENCY_API_KEY=
# FX_RATE_USD_THB=
# WEBHOOK_TEST_MODE=
# EMAIL_TEST_REWRITE_TO=

# Invoice Service (icopay) — formal PDF on paid orders (ChillPay settle + ontheline Paid)
# Also powers Admin → Sales → Invoice list/PDF proxy.
# Issue API key in Invoice Admin → Sites → dealmai → Create key (shown once).
# INVOICE_BASE_URL=https://invoice.icopay.net
# INVOICE_API_KEY=inv_...
# INVOICE_HMAC_SECRET=...
# INVOICE_SITE_CODE=dealmai
